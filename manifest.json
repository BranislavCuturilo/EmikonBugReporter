{
  "manifest_version": 3,
  "name": "Emikon Bug Reporter",
  "version": "0.2.0",
  "description": "Sesijsko prikupljanje dokaza (slike, konzola, mreza, video) + AI sklapanje tiketa za tiket.emikon.rs",
  "homepage_url": "https://github.com/BranislavCuturilo/EmikonBugReporter",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "debugger",
    "tabCapture",
    "sidePanel",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "Emikon Bug Reporter — otvori panel"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/probe.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
